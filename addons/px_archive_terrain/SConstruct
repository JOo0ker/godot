import os
import sys

def find_godot_cpp_path():
    candidates = []
    env_path = os.environ.get("GODOT_CPP_PATH")
    if env_path:
        candidates.append(env_path)
    candidates.append(os.path.abspath(os.path.join("..", "..", "..", "godot-cpp")))
    candidates.append("godot-cpp")

    for candidate in candidates:
        sconstruct = os.path.join(candidate, "SConstruct")
        if os.path.isfile(sconstruct):
            return candidate

    print("Unable to find godot-cpp. Set GODOT_CPP_PATH or place it next to the godot/phoenix-gamma folder.")
    sys.exit(1)

env = SConscript(os.path.join(find_godot_cpp_path(), "SConstruct"))

platform = env["platform"]
target = env["target"]
arch = env.get("arch", "x86_64")
target_name = "debug" if target in ["editor", "template_debug"] else "release"

env.Append(CPPPATH=["src", "thirdparty/lzma"])

sources = Glob("src/*.cpp") + Glob("thirdparty/lzma/*.c")
sources.append(env.GodotCPPDocData("src/gen/doc_data.gen.cpp", source=Glob("doc_classes/*.xml")))

if platform == "windows":
    library_name = f"bin/windows/px_archive_terrain.windows.{target_name}.{arch}.dll"
elif platform == "linux":
    library_name = f"bin/linux/libpx_archive_terrain.linux.{target_name}.{arch}.so"
elif platform == "macos":
    library_name = f"bin/macos/libpx_archive_terrain.macos.{target_name}.framework"
else:
    print(f"Unsupported platform: {platform}")
    sys.exit(1)

library = env.SharedLibrary(library_name, sources)
Default(library)
